<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="720dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Large"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/tagline" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/open_canvas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/open_canvas" />

            <Button
                android:id="@+id/disconnect"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/disconnect" />
        </LinearLayout>

        <TextView
            style="@style/SectionHeader"
            android:text="@string/usb_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/usb_help" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/wifi_header" />

        <LinearLayout
            android:id="@+id/pc_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/pc_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wifi_searching" />

        <Button
            android:id="@+id/connect_ip"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/connect_by_ip" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/canvas_header" />

        <TextView
            android:id="@+id/area_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/area_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:max="75" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/area_help"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Small" />

        <Switch
            android:id="@+id/keep_screen_on"
            style="@style/SettingSwitch"
            android:text="@string/pref_keep_screen_on" />

        <Switch
            android:id="@+id/dark_canvas"
            style="@style/SettingSwitch"
            android:text="@string/pref_dark_canvas" />

        <Switch
            android:id="@+id/show_outline"
            style="@style/SettingSwitch"
            android:text="@string/pref_show_outline" />

        <Switch
            android:id="@+id/show_status"
            style="@style/SettingSwitch"
            android:text="@string/pref_show_status" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/screen_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_help" />

        <EditText
            android:id="@+id/shortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="@string/shortcuts_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textNoSuggestions"
            android:minLines="3"
            android:typeface="monospace" />

        <Button
            android:id="@+id/shortcuts_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shortcuts_save" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/study_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/study_help" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/study_history"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/study_history" />

            <Button
                android:id="@+id/study_ask_tablet"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/study_ask_tablet" />
        </LinearLayout>

        <TextView
            style="@style/SectionHeader"
            android:text="@string/write_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/write_help" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/api_key"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="password"
                android:hint="@string/api_key_hint"
                android:inputType="textPassword"
                android:minHeight="48dp"
                android:singleLine="true" />

            <Button
                android:id="@+id/api_key_save"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/api_key_save" />
        </LinearLayout>

        <TextView
            android:id="@+id/spend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Small" />

        <Switch
            android:id="@+id/add_space"
            style="@style/SettingSwitch"
            android:text="@string/pref_add_space" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/ime_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ime_help" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ime_enable"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_enable" />

            <Button
                android:id="@+id/ime_pick"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_pick" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/spen_note" />
    </LinearLayout>
</ScrollView>
