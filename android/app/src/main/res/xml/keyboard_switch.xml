<?xml version="1.0" encoding="utf-8"?>
<!-- Only needs to know where the keyboard window is; never reads what's on screen or typed. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/switch_service_description"
    android:notificationTimeout="100"
    android:summary="@string/switch_service_summary" />
